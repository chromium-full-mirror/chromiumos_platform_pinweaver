import("//common-mk/pkg_config.gni")

group("all") {
  deps = [ ":libpinweaver" ]
}

config("target_defaults") {
  include_dirs = [
    ".",
    "eal/tpm_storage",
  ]
}

static_library("libpinweaver") {
  sources = [ "pinweaver.c" ]
  configs -= [ "//common-mk:use_thin_archive" ]
  configs += [
    "//common-mk:nouse_thin_archive",
    ":target_defaults",
  ]
  defines = [
    "BIOMETRICS_DEV=${use.biometrics_dev}",
  ]
}
